# LangSmith — tracing and observability
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=lca-deepagents
# Non-US region? Uncomment your endpoint (else your API key won't authenticate):
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com    # GCP EU
# LANGSMITH_ENDPOINT=https://apac.api.smith.langchain.com  # GCP APAC

# ── Snowflake Cortex — the model provider this repo is configured to use ──────
# models.py points ChatOpenAI at Snowflake's OpenAI-compatible Cortex endpoint,
# so no Anthropic/OpenAI key is required. Inference runs inside the Snowflake
# perimeter and bills as Snowflake credits.
#   Docs: https://docs.snowflake.com/en/user-guide/snowflake-cortex/cortex-rest-api
SNOWFLAKE_ACCOUNT=MYORG-MYACCOUNT
SNOWFLAKE_PAT=your-snowflake-programmatic-access-token
# Optional: pin the full base URL instead of deriving it from SNOWFLAKE_ACCOUNT
# SNOWFLAKE_CORTEX_BASE_URL=https://MYORG-MYACCOUNT.snowflakecomputing.com/api/v2/cortex/v1

# Model provider API keys — NOT needed with the Snowflake setup above.
# Uncomment one only if you revert models.py to a stock provider.
# ANTHROPIC_API_KEY=your-anthropic-api-key
# OPENAI_API_KEY=your-openai-api-key
# GOOGLE_API_KEY=your-google-api-key

# OpenRouter: optional, for trying free hosted open-source models (used in the Models lesson)
# Get a free key at https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-v1-...

# Tavily web search — for the research labs (Module 4 and the Module 5
# newsletter). Leave blank to run those labs without web search.
# Get a free key at https://app.tavily.com
TAVILY_API_KEY=

# GitHub OAuth app — optionally setup and used in Module 1.6 Lab 2 (MCP OAuth flow).
# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-client-secret
